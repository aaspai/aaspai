{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "envMode": "loose",
  "globalDependencies": ["biome.json", "tsconfig.base.json"],
  "globalEnv": ["AASPAI_CWD", "AASPAI_DB", "NODE_ENV"],
  "tasks": {
    "build": {
      "outputs": ["dist/**", ".next/**", ".next-dev*/**", "!.next/cache/**", "tsconfig.tsbuildinfo"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "outputs": []
    },
    "typecheck": {
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
