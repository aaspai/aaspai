{
  "name": "@aaspai/worker",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./src/main.ts",
  "bin": {
    "aaspai-worker": "./src/main.ts"
  },
  "scripts": {
    "dev": "tsx watch ./src/main.ts",
    "start": "tsx ./src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run --passWithNoTests",
    "test:real:company:local": "node ../../node_modules/tsx/dist/cli.mjs __tests__/real-e2e/run-real-company.ts local",
    "test:real:zedblock:local": "node ../../node_modules/tsx/dist/cli.mjs __tests__/real-e2e/run-real-company.ts local zedblock",
    "test:simulate:company": "node ../../node_modules/tsx/dist/cli.mjs __tests__/real-e2e/run-real-company.ts simulation",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@aaspai/company": "workspace:*",
    "@aaspai/contracts": "workspace:*",
    "@aaspai/db": "workspace:*",
    "@aaspai/execution": "workspace:*",
    "@aaspai/file-loader": "workspace:*",
    "@aaspai/git": "workspace:*",
    "@aaspai/knowledge": "workspace:*",
    "@aaspai/loops": "workspace:*",
    "@aaspai/memory": "workspace:*",
    "@aaspai/observability": "workspace:*",
    "@aaspai/sessions": "workspace:*",
    "@aaspai/skills": "workspace:*",
    "@aaspai/telemetry": "workspace:*",
    "@aaspai/tools": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.1",
    "@types/node": "^24.0.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.16.2",
    "typescript": "^5.8.3",
    "vitest": "4.1.9"
  }
}
