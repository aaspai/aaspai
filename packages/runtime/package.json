    "verify": "yarn lint && yarn typecheck && yarn test",
    "snapshot:daytona": "node ../../node_modules/tsx/dist/cli.mjs scripts/create-daytona-snapshot.ts",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@aaspai/contracts": "workspace:*",
    "@daytonaio/sdk": "0.171.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.1",
    "@types/node": "^24.0.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.8.3",
    "vitest": "4.1.9"
  }
}
