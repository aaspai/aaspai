{
  "name": "aaspai",
  "version": "0.0.0",
  "private": true,
  "packageManager": "yarn@4.5.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "node scripts/test-workspaces.mjs",
    "test:unit": "node scripts/test-workspaces.mjs",
    "check:dependencies": "node scripts/check-dependencies.mjs",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test:real": "yarn workspace @aaspai/harness run test:real",
    "test:real:company:local": "yarn workspace @aaspai/worker test:real:company:local",
    "test:real:zedblock:local": "yarn workspace @aaspai/worker test:real:zedblock:local",
    "test:simulate:company": "yarn workspace @aaspai/worker test:simulate:company",
    "clean": "turbo run clean"
  },
  "engines": {
    "node": ">=20.18.0 <21"
  },
  "resolutions": {
    "node-gyp": "npm:10.2.0",
    "undici": "npm:6.21.0"
  },
  "devDependencies": {
    "turbo": "^2.10.8"
  }
}
