{
  "name": "aaspai",
  "version": "0.0.0",
  "private": true,
  "packageManager": "yarn@4.5.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "yarn workspaces foreach -A --topological-dev run build",
    "test": "yarn workspaces foreach -A run test",
    "lint": "yarn workspaces foreach -A run lint",
    "typecheck": "yarn workspaces foreach -A run typecheck",
    "test:real": "yarn workspace @aaspai/harness run test:real",
    "test:real:company:local": "yarn workspace @aaspai/worker test:real:company:local",
    "test:real:zedblock:local": "yarn workspace @aaspai/worker test:real:zedblock:local",
    "test:simulate:company": "yarn workspace @aaspai/worker test:simulate:company",
    "clean": "yarn workspaces foreach -A run clean"
  },
  "engines": {
    "node": ">=20.18.0 <21"
  },
  "resolutions": {
    "node-gyp": "npm:10.2.0",
    "undici": "npm:6.21.0"
  }
}
