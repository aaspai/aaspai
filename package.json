{
  "name": "aaspai",
  "version": "0.0.0",
  "private": true,
  "packageManager": "yarn@4.5.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/harness/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "node scripts/test-workspaces.mjs",
    "test:unit": "node scripts/test-workspaces.mjs",
    "check:dependencies": "node scripts/check-dependencies.mjs",
    "check:architecture": "node scripts/check-runtime-harness-architecture.mjs",
    "verify:production": "yarn check:dependencies && yarn check:architecture && yarn workspace @aaspai/runtime verify && yarn workspace @aaspai/harness verify && yarn workspace @aaspai/opencode verify",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test:real:production": "node --import tsx scripts/real-production-smoke.ts",
    "clean": "turbo run clean"
  },
  "engines": {
    "node": ">=20.18.0 <21"
  },
  "resolutions": {
    "node-gyp": "npm:10.2.0",
    "undici": "npm:6.21.0"
  },
  "devDependencies": {
    "turbo": "^2.10.8"
  }
}
