# Required for Daytona company execution.
DAYTONA_API_KEY=

# Required by the development attempt gateway. It stays in a host gateway for
# Docker-only development or an isolated gateway when Daytona is configured.
# Agent runtimes receive only expiring attempt tokens.
OPENROUTER_API_KEY=

# Optional overrides.
AASPAI_GATEWAY_MODEL=poolside/laguna-s-2.1:free
DAYTONA_SNAPSHOT=aaspai-opencode-1-18-5-v3

# Production may supply an already-deployed gateway instead.
# AASPAI_GATEWAY_CONTROL_URL=https://gateway.example.com
# AASPAI_GATEWAY_CONTROL_TOKEN=
# AASPAI_GATEWAY_AGENT_BASE_URL=https://gateway.example.com/v1
